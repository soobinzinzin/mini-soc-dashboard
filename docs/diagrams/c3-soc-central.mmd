    classDef dbStyle fill:#0288d1,stroke:#01579b,stroke-width:2px,color:#ffffff;
    classDef externalStyle fill:#888888,stroke:#555555,stroke-width:2px,color:#ffffff;
    classDef boundaryStyle fill:#f9fbfd,stroke:#1168bd,stroke-width:2px,stroke-dasharray: 5 5,color:#1168bd;
    classDef subflowStyle fill:#ffffff,stroke:#cccccc,stroke-width:1px,stroke-dasharray: 3 3,color:#333333;

    class Central_Container boundaryStyle;
