# 3 rule kế thừa từ đồ án ĐACS 2025, dùng chung cho cả 3 sensor
alert icmp any any -> $HOME_NET any (itype:8; msg:"ICMP Flood Attack Detected"; threshold: type both, track by_src, count 10, seconds 5; sid:1000001; rev:2;)
alert tcp any any -> $HOME_NET any (flags:S; msg:"TCP SYN Port Scan Detected"; threshold: type both, track by_src, count 20, seconds 5; sid:1000002; rev:2;)
alert tcp any any -> $HOME_NET 22 (flags:S; msg:"SSH Brute Force Attempt"; threshold: type both, track by_src, count 5, seconds 60; sid:1000003; rev:2;)
